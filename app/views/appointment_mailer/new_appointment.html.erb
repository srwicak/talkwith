<div class="email-container">
  <div class="header">
    <h2>Hi <%= @name %>, Your Appointment Details</h2>
  </div>
  <div class="details">
    <p><strong>Subject: </strong><%= @appointment.subject %></p>
    <p><strong>Date: </strong><%= @start_time.strftime('%B %dth, %Y') %></p>
    <p>
      <strong>Time: </strong>
      <%= @start_time.strftime('%H:%M') %> - <%= @end_time.strftime('%H:%M') %>
      (<%= @start_time.strftime('%Z') %>)
    </p>
    <p><strong>Description: </strong><%= @appointment.description %>
    </p>
    <p><strong>Your secret key: </strong><%= @appointment.secret_key %></p>
  </div>
  <div class="btn-container">
    <a href="<%= appointment_url(@appointment.slug) %>" class="btn">
      View Appointment
    </a>
  </div>
  <p>If you have any questions, feel free to contact <a href="mailto:me@sandyrw.com">me</a>.</p>
  <img class="stamp" src="https://prangko.app/stamp/track/<%=@appointment.slug%>.png">
</div>
