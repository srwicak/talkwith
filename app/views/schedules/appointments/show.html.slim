.h-screen.justify-center.flex.items-center.bg-gray-400
  .max-w-xl.mx-auto.p-4.bg-indigo-600.shadow-lg.rounded-lg.text-white(class="shadow-blue-500/50 hover:shadow-green-400/50")
    - if params[:secret_key] != @appointment.secret_key
      h2.text-lg.text-center.font-bold.mb-4 Appointment Access
      = form_with url: appointment_path(@appointment.slug), method: :get, local: true do |form|
        = form.label :secret_key, "Secret key (on your email)", class: "block mb-2 text-sm font-medium"
        = form.password_field :secret_key, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500", placeholder: "Enter appointment secret key", required: true
        = form.submit "Submit", class: "p-2 mt-2 bg-blue-500 text-white rounded-lg w-full"

    - else
      h2.text-lg.text-center.font-bold Appointment Details
      hr.h-px.my-4.bg-gray-200.border-0
      p.mb-4 Hi #{@appointment_details[:name]}, your appointment details are as follows:
      p.mb-2
        span.font-semibold Subject: 
        span #{@appointment.subject}
      p.mb-2
        span.font-semibold Date: 
        span #{@appointment_details[:date]}
      p.mb-2
        span.font-semibold Time: 
        span #{@appointment_details[:start_time]} - #{@appointment_details[:end_time]} (#{@appointment[:timezone_offset]})
      p.font-semibold Description
      p.ml-8.mb-4(class="max-h-[120px] overflow-y-auto") #{@appointment.description}
      p.mb-2
        span.font-semibold Status: 
        span #{@appointment_details[:status]}

      .mt-4.flex.flex-wrap.gap-2
        = link_to "Download Appointment (.ics)", download_ics_appointment_path(@appointment.slug, secret_key: @appointment.secret_key), class: "focus:outline-none text-white bg-green-700 hover:bg-green-800 focus:ring-4 focus:ring-green-300 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800"

        - if @appointment.start_time > 2.hours.from_now
          = link_to "Cancel Appointment", cancel_appointment_path(@appointment.slug, secret_key: @appointment.secret_key), method: :delete, class: "focus:outline-none text-white bg-red-700 hover:bg-red-800 focus:ring-4 focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800", data: { confirm: "Are you sure you want to cancel this appointment? This action cannot be undone and will remove it from all calendars." }
        - else
          .text-yellow-300.text-sm.italic Cannot cancel - too close to start time or appointment has passed

        // TODO: Add edit appointment button
        / = button_to "Edit Appointment", '#', class: "focus:outline-none text-white bg-yellow-400 hover:bg-yellow-500 focus:ring-4 focus:ring-yellow-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mb-2 dark:focus:ring-yellow-900", data: { action: 'click->modal#open' }

        // TODO: Add edit appointment modal
