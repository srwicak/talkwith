- content_for :content do
  = render "shared/mode_switcher"

  div(data-controller="schedules--bookings")
    h1.my-4.text-4xl.font-extrabold.leading-none.tracking-tight.text-gray-900.md:text-5xl.md:my-6.lg:text-6xl.lg:my-8.dark:text-white 
      p TalkWith
      p.text-blue-600.dark:text-blue-500 Sandy R Wicaksono
    
    // Calendar Controls
    .flex.flex-col.space-y-2.mb-4.md:flex-row.md:justify-between.md:space-y-0
      .flex.items-center
        h2#monthYear.text-xl.font-bold.dark:text-white(class ="w-[200px]" data-schedules--bookings-target="monthYear")
      
      .flex.space-x-2
        button#prevMonthBtn.px-4.py-2.bg-gray-300.hover:bg-gray-400.rounded.text-sm.font-semibold(data-action="click->schedules--bookings#previousMonth") 
          i.ri-arrow-left-line
          span.ml-2 prev
        button#todayBtn.px-4.py-2.bg-blue-500.text-white.hover:bg-blue-600.rounded.text-sm.font-semibold(data-action="click->schedules--bookings#now") Today
        button#nextMonthBtn.px-4.py-2.bg-gray-300.hover:bg-gray-400.rounded.text-sm.font-semibold(data-action="click->schedules--bookings#nextMonth") 
          span.mr-2 next
          i.ri-arrow-right-line

      .flex
        button#scheduleModalBtn.px-4.py-2.bg-green-500.text-white.hover:bg-green-600.rounded.text-sm(data-action="click->schedules--bookings#showFormModal") 
          t.ri-calendar-schedule-line.mr-2
          span.font-semibold Schedule Appointment
    
    // Calendar Main Grid
    .grid.grid-cols-7.gap-2.text-center
      .font-semibold.text-red-600 Sun
      .font-semibold.dark:text-gray-200 Mon
      .font-semibold.dark:text-gray-200 Tue
      .font-semibold.dark:text-gray-200 Wed
      .font-semibold.dark:text-gray-200 Thu
      .font-semibold.dark:text-gray-200 Fri
      .font-semibold.dark:text-gray-200 Sat

    #calendarGrid.grid.grid-cols-7.gap-2.text-center.mt-2(data-schedules--bookings-target="calendar")

    // Schedule List
    .mt-6.dark:text-gray-200.p-4.border-blue-800.border-4.rounded.shadow-xl.mb-16
      h3.text-2xl.font-bold.underline Schedules
      i.text-sm.text-red-600 This schedule follow your timezone
      p.text-sm
        span Your timezone: 
        span#user-timezone.font-bold(data-schedules--bookings-target="userTimezone")
      ul#eventList.list-disc.list-inside.mt-2(data-schedules--bookings-target="eventList")

    // New Schedule Modal
    = render "form"

    // Success modal
    #success-modal.fixed.inset-0.flex.items-center.justify-center.bg-gray-500.bg-opacity-50.hidden(data-schedules--bookings-target="successModal")
      .bg-white.p-6.rounded-lg.shadow-lg.max-w-sm.w-full.text-center
        h2.text-xl.font-semibold.text-green-500 Booking Successful!
        p.text-gray-700.mt-2 Your appointment has been successfully added to the calendar. Also check your email for detail.
        button.mt-4.px-4.py-2.bg-green-500.text-white.rounded.hover:bg-green-600.w-full(data-action="click->schedules--bookings#hideSuccessModal") OK

    // Conflict modal
    #conflict-modal.fixed.inset-0.flex.items-center.justify-center.bg-gray-500.bg-opacity-50.hidden(data-schedules--bookings-target="conflictModal")
      .bg-white.p-6.rounded-lg.shadow-lg.max-w-sm.w-full.text-center
        h2.text-xl.font-semibold.text-yellow-500 Booking Time Conflict!
        p.text-gray-700.mt-2 The selected time overlaps with an approved booking. Please choose another time.
        button.mt-4.px-4.py-2.bg-yellow-500.text-white.rounded.hover:bg-yellow-600.w-full(data-action="click->schedules--bookings#hideConflictModal") OK

    // Fail modal    
    #failed-modal.fixed.inset-0.flex.items-center.justify-center.bg-gray-500.bg-opacity-50.hidden(data-schedules--bookings-target="failedModal")
      .bg-white.p-6.rounded-lg.shadow-lg.max-w-sm.w-full.text-center
        h2.text-xl.font-semibold.text-red-500 Booking Failed!
        p.text-gray-700.mt-2 An error occurred while adding your appointment. Please check your input or try again later.
        button.mt-4.px-4.py-2.bg-red-500.text-white.rounded.hover:bg-red-600.w-full(data-action="click->schedules--bookings#hideFailedModal") OK

= render "layouts/app_main"
