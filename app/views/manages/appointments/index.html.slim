div.min-h-screen.bg-gray-100.flex.flex-col
  nav.bg-blue-600.text-white.shadow-md
    div.container.mx-auto.flex.justify-between.items-center.px-4.py-3
      h1.text-lg.font-bold Dashboard
      ul.flex.space-x-4
        li
          = link_to "Home", root_path, class: "hover:underline"
        li
          = link_to "Profile", class: "hover:underline"
        li
          = link_to "Settings", class: "hover:underline"
        li
          = button_to "Logout", destroy_user_session_path, method: :delete, class: "bg-red-500 hover:bg-red-600 text-white py-2 px-4 rounded", data: { confirm: "Are you sure you want to log out?" }

  main.container.mx-auto.flex-grow.px-4.py-6
    h2.text-2xl.font-semibold.text-gray-700 Welcome to your dashboard
    p.text-gray-600.mt-2 Manage your account and settings here.

  footer.bg-gray-800.text-white.text-center.py-4
    p.text-sm © 2024 Your Application. All rights reserved.
