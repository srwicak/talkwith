.container.mx-auto.px-4.py-8
  .bg-white.rounded-2xl.shadow-lg.p-8
    
    / Header
    .flex.items-center.justify-between.mb-8
      div
        h1.text-3xl.font-bold.text-gray-900.mb-2
          | ⚙️ Konfigurasi Hari UDI x ITB
        p.text-gray-600
          | Atur hari-hari dan jam operasional untuk booking UDI x ITB
      
      = link_to new_manages_udi_configuration_path, class: "px-6 py-3 bg-gradient-to-r from-purple-500 to-blue-500 text-white rounded-lg hover:from-purple-600 hover:to-blue-600 transition-all duration-200 font-medium shadow-lg hover:shadow-xl" do
        span.mr-2 ➕
        | Tambah Hari Baru

    / Summary Stats
    .grid.grid-cols-1.md:grid-cols-3.gap-6.mb-8
      .bg-gradient-to-br.from-green-50.to-green-100.border.border-green-200.rounded-xl.p-6
        .flex.items-center.justify-between
          div
            p.text-sm.text-green-600.font-medium.mb-1 Hari Aktif
            p.text-3xl.font-bold.text-green-700 = @configurations.where(enabled: true).count
          .text-4xl 📅
      
      .bg-gradient-to-br.from-gray-50.to-gray-100.border.border-gray-200.rounded-xl.p-6
        .flex.items-center.justify-between
          div
            p.text-sm.text-gray-600.font-medium.mb-1 Total Hari Dikonfigurasi
            p.text-3xl.font-bold.text-gray-700 = @configurations.count
          .text-4xl 🗓️
      
      .bg-gradient-to-br.from-blue-50.to-blue-100.border.border-blue-200.rounded-xl.p-6
        .flex.items-center.justify-between
          div
            p.text-sm.text-blue-600.font-medium.mb-1 Total Slot/Hari (Rata-rata)
            p.text-3xl.font-bold.text-blue-700 
              - total_slots = @configurations.where(enabled: true).sum(&:total_slots)
              - active_days = @configurations.where(enabled: true).count
              = active_days > 0 ? (total_slots / active_days).round : 0
          .text-4xl ⏰

    / Configurations List
    - if @configurations.empty?
      .text-center.py-16
        .w-32.h-32.mx-auto.mb-6.bg-gray-100.rounded-full.flex.items-center.justify-center
          span.text-6xl 📅
        h3.text-xl.font-medium.text-gray-600.mb-3
          | Belum Ada Konfigurasi
        p.text-gray-500.mb-6
          | Klik tombol "Tambah Hari Baru" untuk mulai mengatur jadwal booking
        = link_to new_manages_udi_configuration_path, class: "inline-flex items-center px-6 py-3 bg-purple-500 text-white rounded-lg hover:bg-purple-600 transition-colors font-medium" do
          span.mr-2 ➕
          | Tambah Hari Pertama

    - else
      .space-y-4
        - UdiConfiguration::DAYS.each do |day_num, day_info|
          - config = @configurations.find { |c| c.day_of_week == day_num }
          
          .border.rounded-xl.overflow-hidden class=(config&.enabled ? "border-green-200 bg-gradient-to-r from-white to-green-50" : "border-gray-200 bg-gray-50")
            .p-6
              .flex.items-center.justify-between.flex-wrap.gap-4
                
                / Day Info
                .flex.items-center.space-x-4
                  - if config&.enabled
                    .w-4.h-4.bg-green-500.rounded-full.animate-pulse
                  - elsif config
                    .w-4.h-4.bg-gray-400.rounded-full
                  - else
                    .w-4.h-4.border-2.border-dashed.border-gray-300.rounded-full
                  
                  div
                    h3.text-xl.font-semibold class=(config&.enabled ? "text-gray-800" : "text-gray-500")
                      = "#{day_info[:name_id]} "
                      span.text-sm.font-normal.text-gray-500 = "(#{day_info[:name]})"
                    
                    - if config
                      .flex.items-center.space-x-4.mt-2.text-sm
                        .flex.items-center.text-gray-600
                          span.mr-2 🕐
                          span.font-medium = "#{config.start_time} - #{config.end_time}"
                        .flex.items-center.text-gray-600
                          span.mr-2 ⏱️
                          span.font-medium = "#{config.slot_duration} menit/slot"
                        .flex.items-center.text-gray-600
                          span.mr-2 🔄
                          span.font-medium = "#{config.buffer_time} menit buffer"
                        .flex.items-center.text-gray-600
                          span.mr-2 📊
                          span.font-medium = "~#{config.total_slots} slot"
                    - else
                      p.text-sm.text-gray-500.mt-1.italic Belum dikonfigurasi
                
                / Actions
                .flex.items-center.space-x-3
                  - if config
                    / Toggle Enable/Disable
                    = link_to toggle_enabled_manages_udi_configuration_path(config), method: :patch, class: "px-4 py-2 rounded-lg font-medium transition-all duration-200 #{config.enabled ? 'bg-yellow-100 text-yellow-700 hover:bg-yellow-200' : 'bg-green-100 text-green-700 hover:bg-green-200'}" do
                      - if config.enabled
                        span.mr-2 🔕
                        | Nonaktifkan
                      - else
                        span.mr-2 ✅
                        | Aktifkan
                    
                    / Edit
                    = link_to edit_manages_udi_configuration_path(config), class: "px-4 py-2 bg-blue-100 text-blue-700 rounded-lg hover:bg-blue-200 transition-colors font-medium" do
                      span.mr-2 ✏️
                      | Edit
                    
                    / Delete
                    = button_to manages_udi_configuration_path(config), method: :delete, class: "px-4 py-2 bg-red-100 text-red-700 rounded-lg hover:bg-red-200 transition-colors font-medium", data: { turbo_confirm: "Yakin ingin menghapus konfigurasi #{day_info[:name_id]}?" } do
                      span.mr-2 🗑️
                      | Hapus
                  
                  - else
                    / Add Configuration
                    = link_to new_manages_udi_configuration_path(day: day_num), class: "px-4 py-2 bg-purple-100 text-purple-700 rounded-lg hover:bg-purple-200 transition-colors font-medium" do
                      span.mr-2 ➕
                      | Tambah Jadwal

    / Info Box
    .mt-8.bg-blue-50.border.border-blue-200.rounded-xl.p-6
      .flex.items-start.space-x-4
        .text-3xl 💡
        div
          h4.font-semibold.text-blue-900.mb-2 Tips Konfigurasi
          ul.space-y-2.text-sm.text-blue-800
            li ✅ Aktifkan hari yang ingin tersedia untuk booking
            li ⏰ Slot akan dibuat otomatis berdasarkan start time, end time, dan durasi
            li 🔄 Buffer time digunakan untuk jeda antar booking
            li 📅 User hanya bisa booking di hari-hari yang aktif
            li 🎯 Nonaktifkan hari sementara jika tidak tersedia (misalnya libur)

= render "layouts/app_main"
