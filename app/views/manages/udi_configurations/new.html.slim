.container.mx-auto.px-4.py-8.max-w-2xl
  .bg-white.rounded-2xl.shadow-lg.p-8
    
    / Header
    .mb-8
      h1.text-3xl.font-bold.text-gray-900.mb-2
        | ➕ Tambah Konfigurasi Hari
      p.text-gray-600
        | Atur jadwal dan slot waktu untuk hari booking baru

    = form_with model: @configuration, url: manages_udi_configurations_path, local: true, class: "space-y-6" do |form|
      
      / Day Selection
      .form-group
        = form.label :day_of_week, "Pilih Hari", class: "block text-sm font-semibold text-gray-700 mb-2"
        = form.select :day_of_week, options_for_select(UdiConfiguration::DAYS.map { |num, info| ["#{info[:name_id]} - #{info[:name]}", num] }, params[:day]), { prompt: "-- Pilih Hari --" }, class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-gray-900"
        - if @configuration.errors[:day_of_week].any?
          p.text-red-600.text-sm.mt-1 = @configuration.errors[:day_of_week].first

      / Time Range
      .grid.grid-cols-2.gap-4
        .form-group
          = form.label :start_time, "Jam Mulai", class: "block text-sm font-semibold text-gray-700 mb-2"
          = form.text_field :start_time, 
            placeholder: "08:00",
            class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-gray-900"
          p.text-xs.text-gray-500.mt-1 Format: HH:MM - contoh: 08:00
          - if @configuration.errors[:start_time].any?
            p.text-red-600.text-sm.mt-1 = @configuration.errors[:start_time].first

        .form-group
          = form.label :end_time, "Jam Selesai", class: "block text-sm font-semibold text-gray-700 mb-2"
          = form.text_field :end_time, 
            placeholder: "22:00",
            class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-gray-900"
          p.text-xs.text-gray-500.mt-1 Format: HH:MM - contoh: 22:00
          - if @configuration.errors[:end_time].any?
            p.text-red-600.text-sm.mt-1 = @configuration.errors[:end_time].first

      / Slot Settings
      .grid.grid-cols-2.gap-4
        .form-group
          = form.label :slot_duration, "Durasi Slot (menit)", class: "block text-sm font-semibold text-gray-700 mb-2"
          = form.number_field :slot_duration, 
            value: 30,
            min: 10,
            max: 120,
            step: 5,
            class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-gray-900"
          p.text-xs.text-gray-500.mt-1 Durasi standar: 20-30 menit
          - if @configuration.errors[:slot_duration].any?
            p.text-red-600.text-sm.mt-1 = @configuration.errors[:slot_duration].first

        .form-group
          = form.label :buffer_time, "Buffer Time (menit)", class: "block text-sm font-semibold text-gray-700 mb-2"
          = form.number_field :buffer_time, 
            value: 5,
            min: 0,
            max: 30,
            step: 5,
            class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 text-gray-900"
          p.text-xs.text-gray-500.mt-1 Jeda antar booking - biasanya 5 menit
          - if @configuration.errors[:buffer_time].any?
            p.text-red-600.text-sm.mt-1 = @configuration.errors[:buffer_time].first

      / Enabled Toggle
      .form-group
        .flex.items-center.space-x-3.p-4.bg-gray-50.rounded-lg.border.border-gray-200
          = form.check_box :enabled, class: "w-5 h-5 text-purple-600 rounded focus:ring-2 focus:ring-purple-500"
          = form.label :enabled, "Aktifkan hari ini sekarang", class: "text-sm font-medium text-gray-700"
        p.text-xs.text-gray-500.mt-2 
          | Jika dicentang, hari ini akan langsung tersedia untuk booking

      / Info Box
      .bg-blue-50.border.border-blue-200.rounded-lg.p-4
        .flex.items-start.space-x-3
          .text-2xl 💡
          div
            h4.font-semibold.text-blue-900.text-sm.mb-1 Perhitungan Slot Otomatis
            p.text-xs.text-blue-800
              | Jumlah slot dihitung otomatis dari jam operasional dibagi durasi slot + buffer
            p.text-xs.text-blue-700.mt-2
              | Contoh: 08:00-22:00 dengan slot 30 menit + buffer 5 menit = sekitar 24 slot

      / Actions
      .flex.items-center.space-x-4.pt-4
        = form.submit "💾 Simpan Konfigurasi", 
          class: "flex-1 px-6 py-3 bg-gradient-to-r from-purple-500 to-blue-500 text-white rounded-lg hover:from-purple-600 hover:to-blue-600 transition-all duration-200 font-semibold shadow-lg hover:shadow-xl"
        
        = link_to manages_udi_configurations_path, 
          class: "px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors font-semibold" do
          | ❌ Batal

= render "layouts/app_main"
