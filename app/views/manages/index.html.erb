<div class="max-w-6xl mx-auto p-6">
  <!-- Header with logout -->
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold">Appointment Management</h1>
      <div class="mt-1">
        <%= link_to "🎯 Manage UDI x ITB Time Slots", manages_udi_settings_path,
            class: "text-purple-600 hover:text-purple-800 font-medium text-sm" %>
      </div>
    </div>
    <div class="flex gap-3">
      <%= button_to "� Sync TO Google", sync_to_google_manages_path, 
          method: :post, 
          class: "bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded",
          data: { confirm: "Sync pending appointments to Google Calendar?" } %>
      <%= button_to "📥 Sync FROM Google", sync_from_google_manages_path, 
          method: :post, 
          class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded",
          data: { confirm: "Import events from Google Calendar?" } %>
      <%= link_to "🚪 Logout", destroy_user_session_path, 
          method: :delete,
          class: "bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>
  <!-- Pending Appointments -->
  <div class="mb-8">
    <h2 class="text-2xl font-semibold mb-4 text-orange-600">Pending Appointments (<%= @pending_bookings.count %>)</h2>
    <% if @pending_bookings.any? %>
      <div class="bg-white shadow-md rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Subject</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date & Time</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Duration</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @pending_bookings.each do |booking| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900"><%= booking.name %></div>
                  <div class="text-sm text-gray-500"><%= booking.email %></div>
                </td>
                <td class="px-6 py-4">
                  <div class="text-sm text-gray-900"><%= booking.subject %></div>
                  <% if booking.special_booking? %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                      UDI x ITB
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= booking.start_time.in_time_zone(booking.timezone_offset || "Asia/Jakarta").strftime("%d %B %Y") %><br>
                  <%= booking.start_time.in_time_zone(booking.timezone_offset || "Asia/Jakarta").strftime("%H:%M") %> - 
                  <%= booking.end_time.in_time_zone(booking.timezone_offset || "Asia/Jakarta").strftime("%H:%M") %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= booking.duration_minutes %> minutes
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <button onclick="showAppointmentDetails('<%= booking.id %>', '<%= booking.name %>', '<%= booking.email %>', '<%= booking.subject %>', '<%= escape_javascript(booking.description) %>', '<%= booking.start_time.in_time_zone(booking.timezone_offset || "Asia/Jakarta").strftime("%d %B %Y at %H:%M") %>', '<%= booking.end_time.in_time_zone(booking.timezone_offset || "Asia/Jakarta").strftime("%H:%M") %>', '<%= booking.duration_minutes %>')" 
                          class="text-blue-600 hover:text-blue-900 mr-3 cursor-pointer bg-transparent border-none underline">
                    📋 Details
                  </button>
                  <%= button_to "Approve", approve_manage_path(booking), 
                      method: :patch, 
                      class: "text-green-600 hover:text-green-900 mr-3 bg-transparent border-none cursor-pointer",
                      data: { confirm: "Are you sure you want to approve this appointment?" } %>
                  <%= button_to "Reject", reject_manage_path(booking), 
                      method: :delete, 
                      class: "text-red-600 hover:text-red-900 bg-transparent border-none cursor-pointer",
                      data: { confirm: "Are you sure you want to reject this appointment?" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="bg-gray-50 p-6 rounded-lg">
        <p class="text-gray-500">No pending appointments.</p>
      </div>
    <% end %>
  </div>
  <!-- Approved Appointments -->
  <div>
    <h2 class="text-2xl font-semibold mb-4 text-green-600">Approved Appointments (<%= @approved_bookings.count %>)</h2>
    <% if @approved_bookings.any? %>
      <div class="bg-white shadow-md rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Subject</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date & Time</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Google Cal</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% @approved_bookings.each do |booking| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900"><%= booking.name %></div>
                  <div class="text-sm text-gray-500"><%= booking.email %></div>
                </td>
                <td class="px-6 py-4">
                  <div class="text-sm text-gray-900"><%= booking.subject %></div>
                  <% if booking.special_booking? %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                      UDI x ITB
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= booking.start_time.in_time_zone(booking.timezone_offset || "Asia/Jakarta").strftime("%d %B %Y") %><br>
                  <%= booking.start_time.in_time_zone(booking.timezone_offset || "Asia/Jakarta").strftime("%H:%M") %> - 
                  <%= booking.end_time.in_time_zone(booking.timezone_offset || "Asia/Jakarta").strftime("%H:%M") %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if booking.google_calendar_event_id.present? %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      ✓ Synced
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                      ⏳ Pending
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                  <button onclick="showAppointmentDetails('<%= booking.id %>', '<%= booking.name %>', '<%= booking.email %>', '<%= booking.subject %>', '<%= escape_javascript(booking.description) %>', '<%= booking.start_time.in_time_zone(booking.timezone_offset || "Asia/Jakarta").strftime("%d %B %Y at %H:%M") %>', '<%= booking.end_time.in_time_zone(booking.timezone_offset || "Asia/Jakarta").strftime("%H:%M") %>', '<%= booking.duration_minutes %>')" 
                          class="text-blue-600 hover:text-blue-900 mr-3 cursor-pointer bg-transparent border-none underline">
                    📋 Details
                  </button>
                  <%= button_to "❌ Cancel", reject_manage_path(booking), 
                      method: :delete, 
                      class: "text-red-600 hover:text-red-900 bg-transparent border-none cursor-pointer",
                      data: { confirm: "Are you sure you want to cancel this appointment? This will also remove it from Google Calendar." } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="bg-gray-50 p-6 rounded-lg">
        <p class="text-gray-500">No approved appointments.</p>
      </div>
    <% end %>
  </div>
</div>
<!-- Modal for Appointment Details -->
<div id="appointmentModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50">
  <div class="relative top-20 mx-auto p-5 border w-11/12 md:w-3/4 lg:w-1/2 shadow-lg rounded-md bg-white">
    <div class="mt-3">
      <!-- Modal Header -->
      <div class="flex justify-between items-center pb-3">
        <h3 class="text-lg font-medium text-gray-900">📋 Appointment Details</h3>
        <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600">
          <span class="sr-only">Close</span>
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <!-- Modal Body -->
      <div class="mt-4">
        <div class="space-y-4">
          <!-- Client Information -->
          <div class="bg-gray-50 p-4 rounded-lg">
            <h4 class="font-semibold text-gray-700 mb-2">👤 Client Information</h4>
            <p class="text-sm"><span class="font-medium">Name:</span> <span id="modalName"></span></p>
            <p class="text-sm"><span class="font-medium">Email:</span> <span id="modalEmail"></span></p>
          </div>
          <!-- Schedule -->
          <div class="bg-blue-50 p-4 rounded-lg">
            <h4 class="font-semibold text-gray-700 mb-2">📅 Schedule</h4>
            <p class="text-sm"><span class="font-medium">Start:</span> <span id="modalStartTime"></span></p>
            <p class="text-sm"><span class="font-medium">End:</span> <span id="modalEndTime"></span></p>
            <p class="text-sm"><span class="font-medium">Duration:</span> <span id="modalDuration"></span> minutes</p>
          </div>
          <!-- Subject -->
          <div class="bg-purple-50 p-4 rounded-lg">
            <h4 class="font-semibold text-gray-700 mb-2">📝 Subject</h4>
            <p class="text-sm" id="modalSubject"></p>
          </div>
          <!-- Description -->
          <div class="bg-green-50 p-4 rounded-lg">
            <h4 class="font-semibold text-gray-700 mb-2">💬 Description</h4>
            <div class="text-sm max-h-32 overflow-y-auto" id="modalDescription"></div>
          </div>
        </div>
      </div>
      <!-- Modal Footer -->
      <div class="flex justify-end mt-6 pt-4 border-t">
        <button onclick="closeModal()" 
                class="px-4 py-2 bg-gray-300 text-gray-700 rounded-md hover:bg-gray-400 transition duration-200">
          Close
        </button>
      </div>
    </div>
  </div>
</div>
<script>
  function showAppointmentDetails(id, name, email, subject, description, startTime, endTime, duration) {
    // Populate modal with appointment data
    document.getElementById('modalName').textContent = name;
    document.getElementById('modalEmail').textContent = email;
    document.getElementById('modalSubject').textContent = subject;
    document.getElementById('modalDescription').innerHTML = description.replace(/\n/g, '<br>');
    document.getElementById('modalStartTime').textContent = startTime;
    document.getElementById('modalEndTime').textContent = endTime;
    document.getElementById('modalDuration').textContent = duration;

    // Show modal
    document.getElementById('appointmentModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden'; // Prevent background scrolling
  }

  function closeModal() {
    document.getElementById('appointmentModal').classList.add('hidden');
    document.body.style.overflow = 'auto'; // Restore scrolling
  }

  // Close modal when clicking outside of it
  document.getElementById('appointmentModal').addEventListener('click', function(e) {
    if (e.target === this) {
      closeModal();
    }
  });

  // Close modal with Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeModal();
    }
  });
</script>