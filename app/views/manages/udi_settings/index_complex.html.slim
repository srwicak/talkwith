.container.mx-auto.px-4.py-8.max-w-7xl
  
  // Header Section
  .flex.flex-col.lg:flex-row.lg:justify-between.lg:items-center.mb-8.space-y-4.lg:space-y-0
    div
      h1.text-3xl.font-bold.text-gray-900.flex.items-center
        span.mr-3 🎯
        | UDI x ITB Time Slots Management
      p.text-gray-600.mt-2 Manage availability for UDI x ITB coaching sessions
    
    .flex.flex-wrap.gap-3
      = button_to "🔄 Reset Week", manages_udi_settings_reset_week_path, method: :post, class: "px-4 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition-colors", confirm: "This will enable all slots for this week. Continue?"
      = link_to "📊 Back to Dashboard", manages_path, class: "px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 transition-colors"

  // Quick Stats
  .grid.grid-cols-2.lg:grid-cols-4.gap-4.mb-8
    .bg-gradient-to-r.from-green-400.to-green-500.rounded-xl.p-6.text-white.shadow-lg
      .text-3xl.font-bold = @stats[:total_available]
      .text-green-100.text-sm.font-medium Available Slots
      .text-xs.text-green-200.mt-1 Ready for booking
      
    .bg-gradient-to-r.from-blue-400.to-blue-500.rounded-xl.p-6.text-white.shadow-lg
      .text-3xl.font-bold = @stats[:total_booked]  
      .text-blue-100.text-sm.font-medium Booked Sessions
      .text-xs.text-blue-200.mt-1 Confirmed bookings
      
    .bg-gradient-to-r.from-gray-400.to-gray-500.rounded-xl.p-6.text-white.shadow-lg
      .text-3xl.font-bold = @stats[:total_disabled]
      .text-gray-100.text-sm.font-medium Disabled Slots
      .text-xs.text-gray-200.mt-1 Admin disabled
      
    .bg-gradient-to-r.from-purple-400.to-purple-500.rounded-xl.p-6.text-white.shadow-lg
      .text-3xl.font-bold = @stats[:total_slots]
      .text-purple-100.text-sm.font-medium Total Slots
      .text-xs.text-purple-200.mt-1 This week

  // Share UDI Booking Link
  .bg-gradient-to-r.from-blue-50.to-purple-50.border.border-blue-200.rounded-xl.p-6.mb-8
    .flex.items-center.justify-between.mb-4
      h3.text-lg.font-semibold.text-blue-800.flex.items-center
        span.mr-2 🔗
        | UDI Booking Link
      .text-sm.text-blue-600 Share this with participants
    
    .flex.flex-col.sm:flex-row.gap-3
      input.flex-1.px-4.py-3.bg-white.border.border-blue-300.rounded-lg.text-sm.font-mono readonly="readonly" value="#{request.base_url}/udi-booking" id="booking-link"
      button.px-6.py-3.bg-blue-600.text-white.rounded-lg.hover:bg-blue-700.transition-colors.font-medium onclick="copyBookingLink()" Copy Link

  // Time Slots Management
  .bg-white.rounded-xl.shadow-lg.border.border-gray-200.overflow-hidden
    
    // Header
    .bg-gradient-to-r.from-purple-500.to-blue-500.text-white.p-6
      h2.text-xl.font-semibold.flex.items-center
        span.mr-3 ⚙️
        | Slot Availability Settings
      p.text-purple-100.mt-2 Check/uncheck time slots to enable/disable them. Disabled slots won't be available for booking.

    = form_with url: manages_udi_settings_update_slots_path, method: :patch, local: true, class: "p-6" do |form|
      
      - if @available_dates.empty?
        .text-center.py-16
          .w-24.h-24.mx-auto.mb-6.bg-gray-100.rounded-full.flex.items-center.justify-center
            span.text-4xl.text-gray-400 📅
          h3.text-xl.font-medium.text-gray-600.mb-2 No UDI Dates This Week
          p.text-gray-500 Thursday or Friday dates will appear here when available.
          
      - else
        .space-y-8
          - @available_dates.each do |date|
            - date_key = date.strftime('%Y-%m-%d')
            - day_slots = @all_slots_by_day[date] || []
            - disabled_for_date = @disabled_slots[date_key] || []
            
            .border.border-gray-200.rounded-xl.overflow-hidden
              
              // Date Header
              .bg-gray-50.px-6.py-4.border-b.border-gray-200
                .flex.items-center.justify-between
                  .flex.items-center
                    .w-4.h-4.rounded-full class=("#{date.wday == 4 ? 'bg-purple-500' : 'bg-blue-500'}")
                    .ml-4
                      h4.text-lg.font-semibold.text-gray-800
                        = date.strftime('%A')
                      p.text-sm.text-gray-600
                        = date.strftime('%B %d, %Y')
                  
                  .text-right
                    - enabled_count = day_slots.count { |slot| !disabled_for_date.include?(slot[:start]) }
                    - booked_count = day_slots.sum { |slot| @booking_counts.dig(date, slot[:start]) || 0 }
                    .text-sm.font-medium.text-gray-700
                      = "#{enabled_count}/#{day_slots.length} enabled"
                    .text-xs.text-gray-500
                      = "#{booked_count} booked"

              // Slots by Session
              .p-6
                - if day_slots.empty?
                  .text-center.py-8
                    span.text-4xl.mb-2.block 😔
                    p.text-gray-500 No slots configured for this date
                - else
                  - # Group slots by session
                  - slots_by_session = day_slots.group_by { |slot| slot[:session] }
                  - session_info = {
                  -   'morning' => { icon: '🌅', name: 'Morning Session', time: date.wday == 4 ? '08:00-12:00' : '08:00-11:00', color: 'yellow' },
                  -   'afternoon' => { icon: '☀️', name: 'Afternoon Session', time: '13:00-17:30', color: 'orange' },
                  -   'evening' => { icon: '🌙', name: 'Evening Session', time: '19:00-22:00', color: 'indigo' }
                  - }
                  
                  .space-y-6
                    - %w[morning afternoon evening].each do |session_name|
                      - next unless slots_by_session[session_name]
                      - session = session_info[session_name]
                      - session_slots = slots_by_session[session_name]
                      
                      .space-y-4
                        // Session Header
                        .flex.items-center.space-x-3.pb-3.border-b.border-gray-100
                          .w-4.h-4.rounded-full class="bg-#{session[:color]}-400"
                          h5.font-semibold.text-gray-800
                            = "#{session[:icon]} #{session[:name]}"
                          .text-xs.text-gray-500
                            = "(#{session[:time]})"
                          .flex-1
                          .text-xs.text-gray-600
                            - enabled_in_session = session_slots.count { |slot| !disabled_for_date.include?(slot[:start]) }
                            = "#{enabled_in_session}/#{session_slots.length} enabled"
                        
                        // Session Slots Grid
                        .grid.grid-cols-2.sm:grid-cols-3.lg:grid-cols-4.xl:grid-cols-5.gap-3
                          - session_slots.each do |slot|
                            - is_disabled = disabled_for_date.include?(slot[:start])
                            - booking_count = @booking_counts.dig(date, slot[:start]) || 0
                            - is_booked = booking_count > 0
                            
                            .group.relative.p-4.border-2.rounded-xl.transition-all.duration-200 class=("#{is_booked ? 'border-red-300 bg-red-50' : is_disabled ? 'border-gray-300 bg-gray-50' : 'border-green-300 bg-green-50'}")
                              
                              // Checkbox
                              .flex.items-center.justify-between.mb-2
                                = check_box_tag "disabled_slots[#{date_key}][]", slot[:start], !is_disabled, class: "h-4 w-4 text-purple-600 focus:ring-purple-500 border-gray-300 rounded", id: "slot_#{date_key}_#{slot[:start].gsub(':', '')}", disabled: is_booked
                                
                                // Status Indicator  
                                - if is_booked
                                  span.w-3.h-3.bg-red-500.rounded-full.animate-pulse title="Booked"
                                - elsif is_disabled
                                  span.w-3.h-3.bg-gray-400.rounded-full title="Disabled"
                                - else
                                  span.w-3.h-3.bg-green-500.rounded-full title="Available"
                              
                              // Time Label
                              = label_tag "slot_#{date_key}_#{slot[:start].gsub(':', '')}", class: "block text-sm font-medium text-gray-900 cursor-pointer" do
                                .font-semibold = slot[:label]
                                .text-xs class=("#{is_booked ? 'text-red-600' : is_disabled ? 'text-gray-500' : 'text-green-600'}")
                                  - if is_booked
                                    = "#{booking_count} booked"
                                  - elsif is_disabled
                                    | Disabled
                                  - else
                                    | Available
                              
                              // Booked indicator overlay
                              - if is_booked
                                .absolute.inset-0.bg-red-100.bg-opacity-50.rounded-xl.flex.items-center.justify-center
                                  .text-red-700.font-bold.text-xs BOOKED

      // Form Actions
      .border-t.border-gray-200.px-6.py-6.bg-gray-50
        .flex.flex-col.sm:flex-row.sm:justify-between.sm:items-center.space-y-3.sm:space-y-0
          .text-sm.text-gray-600.space-y-1
            .flex.items-center.space-x-4
              .flex.items-center
                .w-3.h-3.bg-green-500.rounded-full.mr-2
                span Available
              .flex.items-center  
                .w-3.h-3.bg-red-500.rounded-full.mr-2
                span Booked
              .flex.items-center
                .w-3.h-3.bg-gray-400.rounded-full.mr-2
                span Disabled
            p.text-xs.text-gray-500 Booked slots cannot be disabled. Cancel bookings first if needed.
          
          = form.submit "💾 Update Slot Settings", class: "px-6 py-3 bg-gradient-to-r from-purple-600 to-blue-600 text-white rounded-lg hover:from-purple-700 hover:to-blue-700 font-medium transition-all shadow-lg hover:shadow-xl"

// JavaScript
javascript:
  function copyBookingLink() {
    const linkInput = document.getElementById('booking-link');
    linkInput.select();
    linkInput.setSelectionRange(0, 99999); // For mobile devices
    
    // Try modern clipboard API first
    if (navigator.clipboard) {
      navigator.clipboard.writeText(linkInput.value).then(() => {
        showCopyFeedback();
      }).catch(() => {
        // Fallback to document.execCommand
        document.execCommand('copy');
        showCopyFeedback();
      });
    } else {
      // Fallback for older browsers
      document.execCommand('copy');
      showCopyFeedback();
    }
  }
  
  function showCopyFeedback() {
    const button = event.target;
    const originalText = button.textContent;
    
    button.textContent = '✅ Copied!';
    button.classList.add('bg-green-600');
    button.classList.remove('bg-blue-600', 'hover:bg-blue-700');
    
    setTimeout(() => {
      button.textContent = originalText;
      button.classList.remove('bg-green-600');
      button.classList.add('bg-blue-600', 'hover:bg-blue-700');
    }, 2000);
  }

  // Add smooth animations for checkboxes
  document.addEventListener('DOMContentLoaded', function() {
    const checkboxes = document.querySelectorAll('input[type="checkbox"]');
    
    checkboxes.forEach(checkbox => {
      checkbox.addEventListener('change', function() {
        const slotContainer = this.closest('.group');
        
        if (this.checked) {
          // Enabling slot
          slotContainer.classList.remove('border-gray-300', 'bg-gray-50');
          slotContainer.classList.add('border-green-300', 'bg-green-50');
        } else {
          // Disabling slot  
          slotContainer.classList.remove('border-green-300', 'bg-green-50');
          slotContainer.classList.add('border-gray-300', 'bg-gray-50');
        }
      });
    });
  });